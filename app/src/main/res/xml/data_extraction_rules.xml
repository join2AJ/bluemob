<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of BlueMob's leaves the phone through Android backup or phone-to-phone transfer: messages, keys,
     contacts and the audit trail stay on this device only. (The data is encrypted anyway, with keys that
     can't leave the Keystore, so a copy would be unreadable.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
